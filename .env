VITE_FIREBASE_MESSAGING_SENDER_ID=623703546449
VITE_FIREBASE_APP_ID=1:623703546449:web:e665775e757d9e45a13670
VITE_ADMIN_WALLET_ADDRESS=0xYourAdminWallet   # optional for the payment log
   VITE_ESCROW_CONTRACT_ADDRESS=0xYourDeployedContractAddress
