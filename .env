# FreshPledge Environment Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# Phase 2: Authentication & Database
# ===========================================
# Get these from your Supabase project or use Lovable Cloud
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# ===========================================
# Phase 6: Blockchain Integration
# ===========================================
# Ethereum/Polygon network configuration
VITE_WEB3_NETWORK=polygon_mumbai
VITE_ESCROW_CONTRACT_ADDRESS=0x3e11f102B3c06EeCF61067986196F4b3865F2afE
VITE_ESCROW_CONTRACT_ADDRESS=0x39d0F5344F652914A8BfD9808061bcDAAA4FaA65
VITE_ADMIN_WALLET_ADDRESS=0xc33cE843cA08dda48Df61adD68f855d96Efd5834

# ===========================================
# Phase 7: Third-Party Services
# ===========================================
# Google Maps API for location services
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Stripe Publishable Key (safe for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ===========================================
# BACKEND SECRETS (DO NOT PUT IN .env.local)
# ===========================================
# These should be managed via Lovable Cloud Secrets:
# - STRIPE_SECRET_KEY
# - SENDGRID_API_KEY
# - SMS_API_KEY
# - WEB3_PRIVATE_KEY (for contract interactions)

# ===========================================
# Development Notes
# ===========================================
# 1. Never commit .env.local to version control
# 2. Keep all secret keys in Lovable Cloud Secrets
# 3. Only publishable/public keys should be in .env.local
# 4. Restart dev server after changing environment variables
  
  
   VITE_FIREBASE_API_KEY=AIzaSyCgXHGeInxlrOgkTPdH5HjP6nkwi3BAUrY
VITE_FIREBASE_AUTH_DOMAIN=flatcom-5f631.firebaseapp.com
